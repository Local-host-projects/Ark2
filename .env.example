# Copy to .env and fill — .env is gitignored (see .gitignore:2)
# Railway: paste these into Variables, not a file.

# --- LLM providers (priority: AgentRouter > Gemini > OpenRouter > Meta) ---
# At least one is needed for live generation; offline engine works without any.
AGENTROUTER_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
META_API_KEY=
# Optional model overrides (defaults in ark/llm.py:27,37,48,61)
# ARK_AGENTROUTER_MODEL=gpt-5.6-sol
# ARK_GEMINI_MODEL=gemini-3.5-flash, gemini-3.5-flash-lite
# ARK_VOICE_MODEL=gemini-3.5-flash-lite   # transcript/speech voice — lite is rawest
# ARK_LLM_PROVIDER_FALLBACK=0            # 1 = try next provider on failure

# --- Research desk (live web grounding) ---
EXA_API_KEY=

# --- App ---
# ARK_PACE_MINUTES=0            # 0 = all days open at once; N = one per N minutes (ark/core.py:1809)
# ARK_GEN_INTERVAL=4            # seconds between background generation ticks (main.py:97)
# ARK_ALLOWED_ORIGINS=https://your-app.up.railway.app,http://localhost:8000
# ARK_DB_PATH=/data/ark.db      # Railway volume mount — see README

# --- Timeouts ---
# ARK_LLM_CONNECT_TIMEOUT=8
# ARK_LLM_READ_TIMEOUT=45
